{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "study_sessions.csv"
  },
  "transform": [
    {
      "calculate": "toDate(datum.date)",
      "as": "dateObj"
    },
    {
      "timeUnit": "yearmonth",
      "field": "dateObj",
      "as": "month"
    }
  ],
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "month",
      "type": "temporal",
      "title": "Month"
    },
    "y": {
      "aggregate": "sum",
      "field": "hours",
      "type": "quantitative",
      "title": "Total Hours"
    }
  }
}
