{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "study_sessions.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "difficulty",
      "type": "nominal",
      "title": "Difficulty"
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Sessions"
    }
  }
}
